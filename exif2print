#!/usr/bin/env python
import sys, os, glob, piexif, argparse

import ExifNotes
from ExifNotes import dry_run, extensions, exif_notes_extension, notes_separator, cs_file_name

params = {
    "paper": {
        "short": "p",
        "label": "Paper",
        "help": "Positive material, e.g. photographic paper"
    },
    "negativeDeveloper": {
        "short": "d",
        "label": "NegativeDev",
        "help": "Negative developer"
    },
    "positiveDeveloper": {
        "short": "o",
        "label": "PositiveDev",
        "help": "Positive developer"
    },
    "multigradeFiltration": {
        "short": "f",
        "label": "MgFiltration",
        "help": "Multigrade filtration"
    },
    "positiveExpositionIndex": {
        "short": "i",
        "label": "PositiveExpIdx",
        "help": "Positive exposition index"
    }
}
parser = argparse.ArgumentParser(description="Positive process EXIF")
parser.add_argument("filename", help="Enlargement scan filename")
for param, meta in params.items():
    parser.add_argument(
        f"-{meta['short']}", 
        f"--{param}", 
        help=meta.get("help", "")
    )
args = parser.parse_args()

target_file = os.path.abspath(args.filename)
if not os.path.isfile(target_file) :
    raise NameError("File " + target_file + " does not exist")
path=os.path.dirname(os.path.dirname(target_file))
ExifNotes.print_verbose('path: ' + path)
src_glob = os.path.basename(os.path.splitext(target_file)[0])
ExifNotes.print_verbose('src_glob: ' + src_glob)
src_files = ExifNotes.get_image_files(glob = src_glob, path = path)
if len(src_files) < 1 :
    raise NameError("Source file matching " + src_glob + " has not been found")
if len(src_files) > 1 :
    raise NameError("More than one source file matching " + src_glob + " has been found")
ExifNotes.print_verbose('src_files: ' + str(src_files))
src_file = path + '/' + src_files[0]
ExifNotes.print_verbose('src_file: ' + src_file)
    
exif_dict = piexif.load(src_file)
#ExifNotes.print_verbose('exif_dict\n' + str(exif_dict))
note = ExifNotes.read_exif (exif_dict['0th'], 'ImageDescription')
for param, meta in params.items():
    value = getattr(args, param, None)
    if value : 
        if note :
            note += notes_separator
        if args.paper :
            note += f"{meta['label']}: {value}"
ExifNotes.print_verbose('note: ' + note)
command = ''
if dry_run :
    command = 'echo '
command += 'exiftool '
if not ExifNotes.read_environ('SAFE') :
    command += " -overwrite_original -ignoreMinorErrors"
command += ' -tagsFromFile "' + src_file + '" -ImageDescription="' + note +'" "' + target_file + '"'
ExifNotes.print_verbose(command)
os.system(command)