#!/bin/bash
exts=("jpg" "jpeg" "tif" "tiff") 

shopt -s nullglob
for ext in ${exts[@]}; do
  for f in *".$ext" ; do 
    if [ "$(exiftool -ImageDescription "$f")" == "" ]; then
      fnb=${f%.*}
      sfs=()
      for sext in ${exts[@]}; do
        sfn="../${fnb}.${sext}"
        [ -f "$sfn" ] && sfs+=( "${sfn}" )
      done
      case ${#sfs[@]} in
        "0")
          echo "No matching source file found for $f" >&2
          continue
          ;;
        "1")
          echo exiftool -tagsFromFile "${sfs[0]}" "$f"
          ;;
        *)
          echo "More than one source file found for $f" >&2
          exit 1
          ;;
      esac
    fi
  done
done
